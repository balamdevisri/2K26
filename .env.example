# ─── Firebase Configuration ──────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Razorpay (Public Key Only — NEVER put secret key here) ──────────────────
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx

# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_ENV=development
# Set to "production" for prod builds

# ─── Cloud Functions Base URL (optional if using default firebase functions) ──
# VITE_FUNCTIONS_BASE_URL=https://us-central1-your_project.cloudfunctions.net

# ─── Firebase Functions Environment (set via firebase functions:config:set) ───
# These are server-side only — NEVER put them in this file for the frontend:
#
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON='{...}'
# GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

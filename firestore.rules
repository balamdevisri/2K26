rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isJudge() {
      return hasRole('judge');
    }
    
    function isVolunteer() {
      return hasRole('volunteer');
    }
    
    function isMentor() {
      return hasRole('mentor');
    }

    // --- Users collection ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Event Configuration (Public read, Admin write) ---
    match /eventConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Problem Statements ---
    match /problemStatements/{problemId} {
      allow read: if resource.data.status == 'PUBLISHED' || isAdmin();
      allow write: if isAdmin();
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Registrations ---
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        isVolunteer()
      );
      // Registrations are created during registration process
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Privileged updates (status, paymentStatus) strictly managed by Admin or Cloud Functions
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Payments ---
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      // All writes managed through server-side Cloud Functions (admin SDK) or Admin
      allow write: if isAdmin();
    }

    // --- Teams ---
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.mentorId == request.auth.uid ||
        isAdmin() ||
        isJudge() ||
        isVolunteer()
      );
      allow create: if isAuthenticated() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (request.auth.uid in resource.data.memberIds && resource.data.isLocked == false) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- Submissions ---
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.status != 'LOCKED' || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- Scores ---
    match /scores/{scoreId} {
      // Individual scores never visible to participants
      allow read: if isAuthenticated() && (
        resource.data.judgeId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isJudge() && request.resource.data.judgeId == request.auth.uid;
      allow update: if isJudge() && (
        resource.data.judgeId == request.auth.uid && 
        resource.data.status != 'FINALIZED'
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Results ---
    match /results/{resultId} {
      allow read: if resource.data.status == 'PUBLISHED' || isAdmin();
      allow write: if isAdmin();
    }

    // --- Check-ins ---
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isVolunteer() ||
        isAdmin()
      );
      allow create: if isVolunteer() || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
